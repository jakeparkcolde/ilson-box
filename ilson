#!/bin/bash
# ilson — one-command onboarding CLI for the agent box (v0, shell).
#
# Commands:
#   setup [--configure-machine] [--sandbox]   provision tools and stage the box
#   start                                    activate after login and onboarding
#   doctor [--probe-tcc]                read-only checks, 12-step mapping
#   init                                 alias for setup
#   pair --code X [--pairing-file F]    (re)write state/pairing.json
#   update                              pull our layer (delegates to lib/update.sh)
#
# --sandbox contract (no-impact on the host):
#   writes ONLY under $ILSON_HOME; never sudo / pmset / sysadminctl / systemsetup /
#   launchctl / tailscale / ~/.claude / ~/Library/LaunchAgents. Steps that need
#   those are reported as "건너뜀(샌드박스)". state/sandbox marks such a box so
#   doctor checks the rendered plists instead of ~/Library/LaunchAgents.
#
# Design: coldbyte-vault wiki/plans/2026-09-05-ilson-init-원커맨드-온보딩-설계.md
# User-facing strings are Korean on purpose; code comments stay English.

set -u

# ~/.local/bin/ilson is a symlink. Templates belong beside the real CLI.
SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
    SELF_PARENT="$(cd "$(dirname "$SELF")" && pwd)"
    SELF="$(readlink "$SELF")"
    case "$SELF" in /*) ;; *) SELF="$SELF_PARENT/$SELF" ;; esac
done
SELF_DIR="$(cd "$(dirname "$SELF")" && pwd)"
TEMPLATE="$SELF_DIR/template"
ILSON_HOME="${ILSON_HOME:-$HOME/ilson}"
TS_BIN="/Applications/Tailscale.app/Contents/MacOS/Tailscale"
[ -x "$TS_BIN" ] || TS_BIN="$HOME/Applications/Tailscale.app/Contents/MacOS/Tailscale"
LAUNCH_AGENTS="$HOME/Library/LaunchAgents"
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"

PROBE_TCC=0; SANDBOX=0; CODE=""; PAIRING_FILE=""
STAGE_ONLY=0; CONFIGURE_MACHINE=0
PASS=0; WARN=0; FAIL=0

# --- output helpers ---------------------------------------------------------
ok()   { PASS=$((PASS+1)); printf '  ✅ %-34s %s\n' "$1" "${2:-}"; }
warn() { WARN=$((WARN+1)); printf '  ⚠️  %-34s %s\n' "$1" "${2:-}"; }
bad()  { FAIL=$((FAIL+1)); printf '  ❌ %-34s %s\n' "$1" "${2:-}"; }
skip() { printf '  ⏭  %-34s %s\n' "$1" "건너뜀(샌드박스)"; }
sec()  { printf '\n[%s] %s\n' "$1" "$2"; }
die()  { printf '\n❌ %s\n' "$1" >&2; exit 1; }
has()  { command -v "$1" >/dev/null 2>&1; }
is_sandbox_box() { [ -f "$ILSON_HOME/state/sandbox" ]; }

# Bound daemon/auth checks even before Homebrew/coreutils exists. No raw error
# output is treated as an address or authentication result.
bounded() {
    local seconds="$1" child timer rc; shift
    "$@" & child=$!
    ( sleep "$seconds"; kill -TERM "$child" 2>/dev/null; sleep 1;
      kill -KILL "$child" 2>/dev/null ) </dev/null >/dev/null 2>&1 & timer=$!
    wait "$child"; rc=$?
    kill "$timer" 2>/dev/null
    wait "$timer" 2>/dev/null
    return "$rc"
}

claude_logged_in() {
    local status
    has claude && has jq || return 1
    status=$(bounded "${ILSON_CHECK_TIMEOUT:-10}" claude auth status 2>/dev/null) || return 1
    printf '%s' "$status" | jq -e '.loggedIn == true' >/dev/null 2>&1
}

# ============================================================================
# doctor — read-only
# ============================================================================
check_preflight() {
    sec 0 "사전 점검"
    local ver arch free
    ver=$(sw_vers -productVersion); arch=$(uname -m)
    [ "$arch" = "arm64" ] && ok "Apple Silicon" "$arch · macOS $ver" || bad "Apple Silicon" "$arch (인텔 맥은 미지원)"
    free=$(df -g / | awk 'NR==2 {print $4}')
    if [ "${free:-0}" -ge 20 ]; then ok "디스크 여유" "${free}GB"; elif [ "${free:-0}" -ge 10 ]; then warn "디스크 여유" "${free}GB (20GB 이상 권장)"; else bad "디스크 여유" "${free}GB"; fi
    curl -fsI --max-time 5 https://gitbap.com >/dev/null 2>&1 && ok "네트워크(gitbap.com)" || bad "네트워크(gitbap.com)" "연결 실패"
    dseditgroup -o checkmember -m "$USER" admin >/dev/null 2>&1 && ok "관리자 계정" "$USER" || bad "관리자 계정" "$USER 는 관리자가 아님"
    fdesetup status 2>/dev/null | grep -q "Off" && ok "FileVault 꺼짐" || warn "FileVault 상태" "암호화 유지 가능 — 재부팅 후 사람이 잠금 해제"
    if has claude; then
        ok "Claude Code 설치" "v$(claude --version 2>/dev/null | awk '{print $1}')"
        claude_logged_in && ok "Claude 로그인" || bad "Claude 로그인" "claude 실행 후 브라우저 로그인 필요 (조회 실패/시간 초과 포함)"
    else
        bad "Claude Code 설치" "https://claude.com/claude-code 한 줄 설치 후 다시"
    fi
}

check_machine() {
    sec 1 "기계 세팅 (헤드리스)"
    local pm; pm=$(pmset -g custom 2>/dev/null)
    _pm() { echo "$pm" | awk -v k="$1" '$1==k {print $2; exit}'; }
    [ "$(_pm sleep)" = "0" ]       && ok "잠자기 금지" "sleep 0" || bad "잠자기 금지" "sleep=$(_pm sleep) (sudo pmset -a sleep 0)"
    [ "$(_pm autorestart)" = "1" ] && ok "정전 후 자동 재시작"    || bad "정전 후 자동 재시작" "sudo pmset -a autorestart 1"
    [ "$(_pm womp)" = "1" ]        && ok "네트워크로 깨우기(WOL)"  || warn "네트워크로 깨우기(WOL)" "sudo pmset -a womp 1"
    local al; al=$(defaults read /Library/Preferences/com.apple.loginwindow autoLoginUser 2>/dev/null)
    [ -n "$al" ] && ok "자동 로그인" "$al" || warn "재부팅 후 로그인" "로그인 후 예약 업무 재개 — 자동 로그인은 선택"
    nc -z -G 1 localhost 22 >/dev/null 2>&1 && ok "SSH 켜짐" "포트 22" || warn "SSH 꺼짐" "Orca 원격 연결만 쓰면 불필요"
    local tz; tz=$(readlink /etc/localtime | sed 's#.*/zoneinfo/##')
    [ "$tz" = "Asia/Seoul" ] && ok "시간대" "$tz" || warn "시간대" "$tz"
    warn "재부팅 복구 시험" "새 맥에서 로그인 후 예약 업무 상태 확인 필요"
}

check_tools() {
    sec 2 "도구"
    has brew && ok "Homebrew" "$(brew --version 2>/dev/null | head -1 | awk '{print $2}')" || bad "Homebrew"
    has git  && ok "git" || bad "git"
    has jq   && ok "jq"  || bad "jq" "brew install jq"
    has gtimeout && ok "업무 시간 제한" || bad "업무 시간 제한" "brew install coreutils"
    has codex && ok "Codex CLI" || warn "Codex CLI" "ilson setup 으로 설치"
    { [ -d /Applications/Obsidian.app ] || [ -d "$HOME/Applications/Obsidian.app" ]; } && ok "Obsidian 앱" || bad "Obsidian 앱" "brew install --cask obsidian"
    [ -x "$TS_BIN" ] && ok "Tailscale 앱" || bad "Tailscale 앱" "brew install --cask tailscale-app"
    has aside && ok "Aside CLI" || warn "Aside (선택)" "브라우저 업무를 사용할 때 연결 — 기본 보고 업무에는 불필요"
}

check_remote() {
    sec 3 "원격 통로"
    if [ -x "$TS_BIN" ]; then
        local ip
        if ip=$(bounded "${ILSON_CHECK_TIMEOUT:-10}" "$TS_BIN" ip -4 2>/dev/null) &&
            printf '%s\n' "$ip" | awk -F. 'NF != 4 {exit 1} {for(i=1;i<=4;i++) if($i !~ /^[0-9]+$/ || $i>255) exit 1; n++} END {if(n!=1) exit 1}'; then
            ok "Tailscale 주소 확인" "$ip (접속 상대와의 연결은 별도 확인)"
        else
            bad "Tailscale 연결 확인 실패" "앱 로그인/데몬 상태 확인 (조회 실패·시간 초과 포함)"
        fi
    else bad "Tailscale CLI" "앱 미설치"; fi
}

check_box() {
    sec 4 "박스 골격 ($ILSON_HOME)"
    if [ -d "$ILSON_HOME" ]; then
        ok "박스 폴더" "$(is_sandbox_box && echo '샌드박스')"
        [ -f "$ILSON_HOME/CLAUDE.md" ]          && ok "행동 규칙 CLAUDE.md" || bad "행동 규칙 CLAUDE.md"
        [ -f "$ILSON_HOME/vault/CONTEXT.md" ]   && ok "볼트 틀"            || bad "볼트 틀"
        [ -d "$ILSON_HOME/.claude/commands" ]   && ok "명령 4개(.claude)"  "$(ls "$ILSON_HOME/.claude/commands" 2>/dev/null | wc -l | tr -d ' ')개" || bad "명령(.claude/commands)"
        [ -x "$ILSON_HOME/lib/run-job.sh" ]     && ok "lib 스크립트"       || bad "lib 스크립트"
        [ -d "$ILSON_HOME/.git" ]               && ok "상태 git 스냅샷"    || bad "상태 git 스냅샷" "lib/snapshot.sh 1회 실행"
        # Project-scope allow rules are ignored until the trust dialog is accepted for
        # this folder (measured 2026-09-05). Jobs use acceptEdits so they still write,
        # but deny rules and any allow rules need trust to be fully honored.
        if jq -e --arg p "$ILSON_HOME" '.projects[$p].hasTrustDialogAccepted == true' "$HOME/.claude.json" >/dev/null 2>&1; then
            ok "박스 신뢰됨(Claude)"
        else warn "박스 미신뢰(Claude)" "박스 폴더에서 claude 를 한 번 열어 신뢰 수락 (init 10단계가 함)"; fi
    else
        bad "박스 폴더" "ilson init 이 만든다"
    fi
    sec 5 "페어링"
    if [ -f "$ILSON_HOME/state/pairing.json" ]; then
        if jq -e 'type == "object"' "$ILSON_HOME/state/pairing.json" >/dev/null 2>&1; then
            ok "로컬 연결 설정" "파일 존재 — 서버 페어링 완료를 뜻하지 않음"
        else bad "연결 설정 손상"; fi
        [ -n "$(jq -r '.telegram_chat_id // empty' "$ILSON_HOME/state/pairing.json" 2>/dev/null)" ] && ok "텔레그램 연결" || warn "텔레그램 미연결" "알림은 로그로만 남음"
    else warn "알림 미연결" "설치코드 없이 로컬 사용 가능. 텔레그램은 별도 연결"; fi
}

check_tcc() {
    sec 6 "권한 (접근성·자동화·전체 디스크)"
    if [ "$PROBE_TCC" = "1" ]; then
        osascript -e 'tell application "System Events" to get name of first process' >/dev/null 2>&1 \
            && ok "자동화+접근성" "System Events 호출 성공" || bad "자동화+접근성" "시스템 설정 > 개인정보 보호에서 터미널 허용"
    else warn "권한 실호출" "--probe-tcc 로 검사 (권한 창이 뜰 수 있음)"; fi
    [ -r "$HOME/Library/Application Support/com.apple.TCC/TCC.db" ] && ok "전체 디스크 접근" || warn "전체 디스크 접근" "이 터미널엔 없음"
}

check_jobs() {
    sec 8 "예약 업무 (launchd)"
    local dir n loaded
    if is_sandbox_box || [ -f "$ILSON_HOME/state/setup-pending" ]; then dir="$ILSON_HOME/launchd/rendered"; else dir="$LAUNCH_AGENTS"; fi
    n=0
    for p in "$dir"/com.ilson.*.plist; do [ ! -f "$p" ] || n=$((n+1)); done
    if [ "$n" -gt 0 ]; then
        ok "ilson 잡 plist" "${n}개$(is_sandbox_box && echo ' (렌더만)')"
        for p in "$dir"/com.ilson.*.plist; do plutil -lint -s "$p" >/dev/null 2>&1 || bad "plist 문법" "$(basename "$p")"; done
        if is_sandbox_box; then skip "잡 적재(launchctl)";
        elif [ -f "$ILSON_HOME/state/setup-pending" ]; then warn "예약 업무 대기" "로그인·회사 인터뷰 후 ilson start";
        else
            loaded=$(launchctl list 2>/dev/null | grep -c 'com\.ilson\.')
            [ "$loaded" -eq "$n" ] && ok "잡 적재" "${loaded}/${n}" || bad "잡 적재" "${loaded}/${n} (launchctl bootstrap 필요)"
        fi
    else bad "ilson 잡 plist" "6개 (브리핑·주간·정리·워치독·스냅샷·업데이트)"; fi
}

check_safety() {
    sec 9 "안전판"
    ok "구독 계정 사용" "설치기가 API 키를 설정하거나 유료 API를 호출하지 않음"
    [ -f "$ILSON_HOME/state/enabled.watchdog" ] && ok "워치독" || bad "워치독"
    [ -f "$ILSON_HOME/state/enabled.snapshot" ] && ok "상태 스냅샷(10분)" || bad "상태 스냅샷(10분)"
}

doctor() {
    printf 'ilson doctor v0 — %s · %s\n' "$(hostname -s)" "$(date '+%Y-%m-%d %H:%M')"
    check_preflight; check_machine; check_tools; check_remote; check_box; check_tcc; check_jobs; check_safety
    printf '\n결과: ✅ %d · ⚠️ %d · ❌ %d\n' "$PASS" "$WARN" "$FAIL"
    if [ -f "$ILSON_HOME/state/setup-pending" ] || is_sandbox_box; then
        echo "기본 구성만 준비됨 — 실제 업무 가동은 아직입니다."
        exit 1
    fi
    [ "$FAIL" -eq 0 ] && { echo "기본 점검 통과 — 경고와 실제 업무/재부팅 시험은 별도 확인하세요."; exit 0; }
    echo "❌ 항목은 'ilson init' 이 처리하거나, 새 맥에서 손으로 할 것들이에요."
    exit 1
}

# ============================================================================
# init — build the box
# ============================================================================

# render_plist <job> <script> <args> <schedule> > file
render_plist() {
    local job="$1" script="$2" args="$3" sched="$4" argxml="" schedxml=""
    [ -n "$args" ] && argxml="<string>$args</string>"
    case "$sched" in
        daily\ *)  set -- $sched; schedxml="<key>StartCalendarInterval</key><dict><key>Hour</key><integer>${2%%:*}</integer><key>Minute</key><integer>$((10#${2##*:}))</integer></dict>" ;;
        weekly\ *) set -- $sched; schedxml="<key>StartCalendarInterval</key><dict><key>Weekday</key><integer>$2</integer><key>Hour</key><integer>${3%%:*}</integer><key>Minute</key><integer>$((10#${3##*:}))</integer></dict>" ;;
        every\ *)  set -- $sched; schedxml="<key>StartInterval</key><integer>$2</integer>" ;;
        *) die "jobs.conf: 모르는 일정 '$sched'" ;;
    esac
    sed -e "s#__JOB__#$job#g" -e "s#__SCRIPT__#$script#g" -e "s#__ARGS__#$argxml#g" \
        -e "s#__SCHEDULE__#$schedxml#g" -e "s#__ILSON_HOME__#$ILSON_HOME#g" -e "s#__HOME__#$HOME#g" \
        "$TEMPLATE/launchd/job.plist.tmpl"
}

init_step_machine() {
    sec 1 "기계 세팅"
    if [ "$SANDBOX" = "1" ]; then skip "pmset·자동 로그인·SSH"; return; fi
    # Real mode — needs an admin password once. Each command is idempotent.
    sudo -p "관리자 비밀번호 (기계 세팅): " pmset -a sleep 0 disksleep 0 displaysleep 10 autorestart 1 womp 1 && ok "잠자기 금지·자동 재시작" || bad "pmset"
    warn "재부팅 후 로그인" "FileVault·화면 잠금 유지. 자동 로그인·SSH는 필요할 때 별도 설정"
}

init_step_box() {
    sec 4 "박스 골격 → $ILSON_HOME"
    mkdir -p "$ILSON_HOME"
    # vault/ is the customer's data: -n never overwrites an existing note on re-run.
    # lib/, .claude/, CLAUDE.md are our layer: always refreshed.
    local new_context=0
    [ -e "$ILSON_HOME/vault/CONTEXT.md" ] || new_context=1
    # macOS cp -n reports nonzero when skipping an existing file. Copy only
    # missing template files so reruns preserve notes and real errors still fail.
    local src dest
    while IFS= read -r src; do
        dest="$ILSON_HOME/vault/${src#"$TEMPLATE/vault/"}"
        if [ ! -e "$dest" ]; then
            mkdir -p "$(dirname "$dest")" && cp "$src" "$dest" || return 1
        fi
    done < <(find "$TEMPLATE/vault" -type f)
    cp -R "$TEMPLATE/lib/." "$ILSON_HOME/lib/" && chmod +x "$ILSON_HOME"/lib/*.sh || return 1
    mkdir -p "$ILSON_HOME/.claude" && cp -R "$TEMPLATE/claude/." "$ILSON_HOME/.claude/" || return 1
    cp "$TEMPLATE/CLAUDE.md" "$ILSON_HOME/CLAUDE.md" || return 1
    mkdir -p "$ILSON_HOME/launchd" && cp "$TEMPLATE/launchd/jobs.conf" "$ILSON_HOME/launchd/" || return 1
    if [ "$new_context" = "1" ]; then sed -i '' "s/__TODAY__/$(date +%F)/" "$ILSON_HOME/vault/CONTEXT.md" || return 1; fi
    mkdir -p "$ILSON_HOME/state" "$ILSON_HOME/logs"
    [ "$SANDBOX" = "1" ] && touch "$ILSON_HOME/state/sandbox"
    if env ILSON_HOME="$ILSON_HOME" bash "$ILSON_HOME/lib/snapshot.sh"; then ok "골격 복사 + 첫 스냅샷";
    else bad "스냅샷"; return 1; fi
}

# pair_write — v0 has no server: code + optional --pairing-file JSON merged in.
pair_write() {
    mkdir -p "$ILSON_HOME/state"
    local base; base=$(jq -n --arg c "$CODE" --arg t "$(date -Iseconds)" '{code:$c, paired_at:$t, source:"v0-file"}')
    if [ -n "$PAIRING_FILE" ]; then
        [ -f "$PAIRING_FILE" ] || die "페어링 파일이 없어요: $PAIRING_FILE"
        jq -s '.[0] * .[1]' <(echo "$base") "$PAIRING_FILE" > "$ILSON_HOME/state/pairing.json"
    else echo "$base" > "$ILSON_HOME/state/pairing.json"; fi
    chmod 600 "$ILSON_HOME/state/pairing.json"
}

init_step_jobs() {
    sec 8 "예약 업무"
    local out="$ILSON_HOME/launchd/rendered"; mkdir -p "$out"
    while IFS='|' read -r job script args sched; do
        job=$(echo "$job" | xargs); [ -z "$job" ] && continue; case "$job" in \#*) continue ;; esac
        script=$(echo "$script" | xargs); args=$(echo "$args" | xargs); sched=$(echo "$sched" | xargs)
        render_plist "$job" "$script" "$args" "$sched" > "$out/com.ilson.$job.plist"
        plutil -lint -s "$out/com.ilson.$job.plist" >/dev/null || die "plist 렌더 실패: $job"
    done < "$ILSON_HOME/launchd/jobs.conf"
    ok "plist 렌더" "$(ls "$out" | wc -l | tr -d ' ')개"
    [ "$STAGE_ONLY" = "1" ] && { warn "예약 업무 대기" "회사 인터뷰 후 ilson start"; return 0; }
    if [ "$SANDBOX" = "1" ]; then skip "launchctl bootstrap"; return; fi
    mkdir -p "$LAUNCH_AGENTS"
    for p in "$out"/com.ilson.*.plist; do
        local label; label=$(basename "$p" .plist)
        # Resuming after a partial start must not restart already running jobs.
        if ! launchctl print "gui/$(id -u)/$label" >/dev/null 2>&1; then
            cp "$p" "$LAUNCH_AGENTS/" || return 1
            launchctl bootstrap "gui/$(id -u)" "$LAUNCH_AGENTS/$(basename "$p")" || { bad "적재" "$label"; return 1; }
        fi
        touch "$ILSON_HOME/state/enabled.${label#com.ilson.}"
    done
    ok "launchd 적재"
}

# Fresh machines need tools before preflight can check them. Keep all privileged
# configuration behind the explicit --configure-machine option; never weaken
# FileVault or login security to turn a warning green.
setup_tools() {
    sec 2 "필수 도구 자동 설치"
    [ "$SANDBOX" = "1" ] && { skip "도구 설치"; return 0; }
    export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
    if ! has brew; then
        [ -t 0 ] || { bad "Homebrew 설치 대기" "새 맥의 대화형 터미널에서 ilson setup 실행"; return 1; }
        local brew_script; brew_script=$(mktemp) || return 1
        if ! curl -fsSL --connect-timeout 10 --max-time 120 https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh -o "$brew_script"; then
            rm -f "$brew_script"; bad "Homebrew 내려받기 실패"; return 1
        fi
        /bin/bash "$brew_script"; local rc=$?; rm -f "$brew_script"
        [ "$rc" -eq 0 ] && has brew || { bad "Homebrew 설치 실패"; return 1; }
    fi
    local formula executable
    for formula in git jq gh coreutils; do
        executable="$formula"; [ "$formula" = coreutils ] && executable=gtimeout
        if ! has "$executable"; then
            brew install "$formula" || { bad "$formula 설치 실패"; return 1; }
        fi
    done
    for executable in claude codex; do
        if ! has "$executable"; then
            local url installer
            case "$executable" in
                claude) url=https://claude.ai/install.sh ;;
                codex) url=https://chatgpt.com/codex/install.sh ;;
            esac
            installer=$(mktemp) || return 1
            if ! curl -fsSL --connect-timeout 10 --max-time 120 "$url" -o "$installer"; then
                rm -f "$installer"; bad "$executable 내려받기 실패"; return 1
            fi
            /bin/bash "$installer"; local rc=$?; rm -f "$installer"
            [ "$rc" -eq 0 ] && has "$executable" || { bad "$executable 설치 실패"; return 1; }
        fi
    done
    if [ ! -d /Applications/Obsidian.app ] && [ ! -d "$HOME/Applications/Obsidian.app" ]; then
        brew install --cask obsidian || { bad "Obsidian 설치 실패"; return 1; }
    fi
    if [ ! -d /Applications/Tailscale.app ] && [ ! -d "$HOME/Applications/Tailscale.app" ]; then
        brew install --cask tailscale-app || { bad "Tailscale 설치 실패"; return 1; }
    fi
    TS_BIN=/Applications/Tailscale.app/Contents/MacOS/Tailscale
    [ -x "$TS_BIN" ] || TS_BIN="$HOME/Applications/Tailscale.app/Contents/MacOS/Tailscale"
    ok "도구 설치 확인"
}

setup() {
    printf '일손 Box 기본 설치 — %s\n' "$ILSON_HOME"
    [ "$(uname -s)" = Darwin ] || die "macOS 전용입니다"
    [ "$(uname -m)" = arm64 ] || die "Apple Silicon 맥미니가 필요합니다"
    [ -f "$TEMPLATE/CLAUDE.md" ] || die "설치본에 template 이 없습니다 — CLI를 다시 설치하세요"
    setup_tools || return 1
    if [ "$CONFIGURE_MACHINE" = "1" ]; then
        if [ "$SANDBOX" = "0" ] && [ ! -t 0 ]; then
            bad "전원 설정 대기" "대화형 터미널에서 ilson setup --configure-machine"; return 1
        fi
        init_step_machine
        [ "$FAIL" -eq 0 ] || return 1
    fi
    init_step_box || return 1
    # Re-running setup preserves the identity and credentials already on this box.
    if [ -n "$CODE" ] || [ -n "$PAIRING_FILE" ]; then
        [ ! -e "$ILSON_HOME/state/pairing.json" ] || die "연결 설정이 이미 있습니다 — 변경은 ilson pair 에서 명시하세요"
        pair_write || return 1
    fi
    if [ ! -f "$ILSON_HOME/state/setup-complete" ]; then touch "$ILSON_HOME/state/setup-pending"; fi
    STAGE_ONLY=1
    init_step_jobs || return 1
    printf '\n기본 설치 완료. 예약 업무는 아직 새로 시작하지 않았습니다.\n'
    [ "$SANDBOX" = "1" ] && { echo '샌드박스: 로그인·시스템 설정·서비스 실행 생략'; return 0; }
    printf '\n사람이 마칠 단계:\n'
    claude_logged_in || printf '  • claude 실행 → 본인 구독 계정으로 로그인\n'
    printf '  • codex 실행 → 본인 ChatGPT 계정으로 로그인 (Box 정기 업무는 Claude 사용)\n'
    printf '  • Tailscale 앱 로그인 및 연결 확인\n'
    printf '  • cd "%s" 후 claude /onboard → 폴더 신뢰 확인과 회사 인터뷰\n' "$ILSON_HOME"
    printf '  • Obsidian 에서 "%s/vault" 폴더 열기\n' "$ILSON_HOME"
    printf '  • 상시 전원 설정: ilson setup --configure-machine (관리자 비밀번호 필요)\n'
    printf '  • 회사 정보 준비 후 ilson start 로 예약 업무 시작\n'
    printf '  • 텔레그램·Aside 및 macOS 권한은 해당 기능 연결 시 설정\n'
    check_remote
    if [ "$FAIL" -gt 0 ]; then
        printf '\n기본 파일 설치는 완료됐지만 연결 확인은 실패했습니다. 위 항목을 해결하세요.\n'
        return 1
    fi
}

start_jobs() {
    [ "$SANDBOX" = "0" ] && ! is_sandbox_box || die "샌드박스에서는 실제 예약 업무를 켜지 않습니다"
    [ -f "$ILSON_HOME/CLAUDE.md" ] || die "먼저 ilson setup 을 실행하세요"
    claude_logged_in || die "Claude 로그인 확인 실패 — 로그인 후 다시 시도하세요"
    has gtimeout || die "업무 시간 제한 도구가 없습니다 — ilson setup 을 다시 실행하세요"
    jq -e --arg p "$ILSON_HOME" '.projects[$p].hasTrustDialogAccepted == true' "$HOME/.claude.json" >/dev/null 2>&1 ||
        die "박스 폴더에서 claude 를 열어 폴더 신뢰를 확인하세요"
    local company
    company=$(sed -n 's/^- 회사명: *//p' "$ILSON_HOME/vault/CONTEXT.md" | head -1)
    case "$company" in ''|'('* ) die "회사 정보가 비어 있습니다 — 박스 폴더에서 claude /onboard 를 실행하세요" ;; esac
    STAGE_ONLY=0
    init_step_jobs || return 1
    rm -f "$ILSON_HOME/state/setup-pending"
    touch "$ILSON_HOME/state/setup-complete"
    ok "예약 업무 시작" "실제 결과와 재부팅 복구는 이후 확인하세요"
    [ -f "$ILSON_HOME/state/pairing.json" ] || warn "텔레그램 미연결" "보고서는 볼트에 저장됩니다. 알림 전송은 별도 연결 필요"
}

usage() {
    cat <<'EOF'
사용법: ilson <명령> [옵션]
  doctor [--probe-tcc]                          박스 상태를 읽기 전용으로 점검
  setup [--configure-machine] [--sandbox]      도구·볼트·예약 파일 구성 (로그인은 직접)
  init                                        setup 과 같은 명령 (코드 없이 로컬 사용 가능)
  start                                       로그인·회사 정보 확인 후 예약 업무 시작
  pair --code <코드> [--pairing-file <json>]     페어링 파일 (다시) 쓰기
  update                                        우리 레이어 업데이트
EOF
}

cmd="${1:-}"; shift || true
while [ $# -gt 0 ]; do
    case "$1" in
        --probe-tcc) PROBE_TCC=1 ;;
        --sandbox) SANDBOX=1 ;;
        --with-claude) die "자동 LLM 실행 대신 박스 폴더에서 claude /onboard 를 실행하세요" ;;
        --configure-machine) CONFIGURE_MACHINE=1 ;;
        --code) CODE="${2:-}"; shift ;;
        --pairing-file) PAIRING_FILE="${2:-}"; shift ;;
        *) echo "모르는 옵션: $1" >&2; usage; exit 2 ;;
    esac; shift
done
case "$cmd" in
    doctor) doctor ;;
    setup|init) setup ;;
    start) start_jobs ;;
    pair)   [ -n "$CODE" ] || die "ilson pair --code XXXX"; pair_write && echo "pairing.json 갱신"; ;;
    update) [ -x "$ILSON_HOME/lib/update.sh" ] || die "박스가 없어요 ($ILSON_HOME)"; env ILSON_HOME="$ILSON_HOME" bash "$ILSON_HOME/lib/update.sh" ;;
    *) usage; exit 2 ;;
esac
