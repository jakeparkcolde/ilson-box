#!/bin/bash
# ilson — one-command onboarding CLI for the agent box (v0, shell).
#
# Commands:
#   doctor [--probe-tcc]                read-only checks, 12-step mapping
#   init --code X [--sandbox] [--with-claude]
#                                       build the box under $ILSON_HOME
#   pair --code X [--pairing-file F]    (re)write state/pairing.json
#   update                              pull our layer (delegates to lib/update.sh)
#
# --sandbox contract (no-impact on the host):
#   writes ONLY under $ILSON_HOME; never sudo / pmset / sysadminctl / systemsetup /
#   launchctl / tailscale / ~/.claude / ~/Library/LaunchAgents. Steps that need
#   those are reported as "건너뜀(샌드박스)". state/sandbox marks such a box so
#   doctor checks the rendered plists instead of ~/Library/LaunchAgents.
#
# Design: coldbyte-vault wiki/plans/2026-09-05-ilson-init-원커맨드-온보딩-설계.md
# User-facing strings are Korean on purpose; code comments stay English.

set -u

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TEMPLATE="$SELF_DIR/template"
ILSON_HOME="${ILSON_HOME:-$HOME/ilson}"
TS_BIN="/Applications/Tailscale.app/Contents/MacOS/Tailscale"
LAUNCH_AGENTS="$HOME/Library/LaunchAgents"
JOBS="briefing weekly tidy watchdog snapshot update"

PROBE_TCC=0; SANDBOX=0; WITH_CLAUDE=0; CODE=""; PAIRING_FILE=""
PASS=0; WARN=0; FAIL=0

# --- output helpers ---------------------------------------------------------
ok()   { PASS=$((PASS+1)); printf '  ✅ %-34s %s\n' "$1" "${2:-}"; }
warn() { WARN=$((WARN+1)); printf '  ⚠️  %-34s %s\n' "$1" "${2:-}"; }
bad()  { FAIL=$((FAIL+1)); printf '  ❌ %-34s %s\n' "$1" "${2:-}"; }
skip() { printf '  ⏭  %-34s %s\n' "$1" "건너뜀(샌드박스)"; }
sec()  { printf '\n[%s] %s\n' "$1" "$2"; }
die()  { printf '\n❌ %s\n' "$1" >&2; exit 1; }
has()  { command -v "$1" >/dev/null 2>&1; }
is_sandbox_box() { [ -f "$ILSON_HOME/state/sandbox" ]; }

# ============================================================================
# doctor — read-only
# ============================================================================
check_preflight() {
    sec 0 "사전 점검"
    local ver arch free
    ver=$(sw_vers -productVersion); arch=$(uname -m)
    [ "$arch" = "arm64" ] && ok "Apple Silicon" "$arch · macOS $ver" || bad "Apple Silicon" "$arch (인텔 맥은 미지원)"
    free=$(df -g / | awk 'NR==2 {print $4}')
    if [ "${free:-0}" -ge 20 ]; then ok "디스크 여유" "${free}GB"; elif [ "${free:-0}" -ge 10 ]; then warn "디스크 여유" "${free}GB (20GB 이상 권장)"; else bad "디스크 여유" "${free}GB"; fi
    curl -fsI --max-time 5 https://gitbap.com >/dev/null 2>&1 && ok "네트워크(gitbap.com)" || bad "네트워크(gitbap.com)" "연결 실패"
    dseditgroup -o checkmember -m "$USER" admin >/dev/null 2>&1 && ok "관리자 계정" "$USER" || bad "관리자 계정" "$USER 는 관리자가 아님"
    fdesetup status 2>/dev/null | grep -q "Off" && ok "FileVault 꺼짐" || warn "FileVault 켜짐" "자동 로그인 불가 → 끄거나 재부팅 시 수동 로그인 감수"
    if has claude; then
        ok "Claude Code 설치" "v$(claude --version 2>/dev/null | awk '{print $1}')"
        claude auth status 2>/dev/null | grep -q '"loggedIn": true' && ok "Claude 로그인" || bad "Claude 로그인" "claude 실행 후 브라우저 로그인 필요"
    else
        bad "Claude Code 설치" "https://claude.com/claude-code 한 줄 설치 후 다시"
    fi
}

check_machine() {
    sec 1 "기계 세팅 (헤드리스)"
    local pm; pm=$(pmset -g custom 2>/dev/null)
    _pm() { echo "$pm" | awk -v k="$1" '$1==k {print $2; exit}'; }
    [ "$(_pm sleep)" = "0" ]       && ok "잠자기 금지" "sleep 0" || bad "잠자기 금지" "sleep=$(_pm sleep) (sudo pmset -a sleep 0)"
    [ "$(_pm autorestart)" = "1" ] && ok "정전 후 자동 재시작"    || bad "정전 후 자동 재시작" "sudo pmset -a autorestart 1"
    [ "$(_pm womp)" = "1" ]        && ok "네트워크로 깨우기(WOL)"  || warn "네트워크로 깨우기(WOL)" "sudo pmset -a womp 1"
    local al; al=$(defaults read /Library/Preferences/com.apple.loginwindow autoLoginUser 2>/dev/null)
    [ -n "$al" ] && ok "자동 로그인" "$al" || bad "자동 로그인" "sudo sysadminctl -autologin set -userName $USER"
    nc -z -G 1 localhost 22 >/dev/null 2>&1 && ok "SSH 켜짐" "포트 22" || bad "SSH" "sudo systemsetup -setremotelogin on"
    local tz; tz=$(readlink /etc/localtime | sed 's#.*/zoneinfo/##')
    [ "$tz" = "Asia/Seoul" ] && ok "시간대" "$tz" || warn "시간대" "$tz"
    warn "화면 잠금 해제" "수동 확인 (sysadminctl -screenLock off 는 비밀번호 필요)"
}

check_tools() {
    sec 2 "도구"
    has brew && ok "Homebrew" "$(brew --version 2>/dev/null | head -1 | awk '{print $2}')" || bad "Homebrew"
    has git  && ok "git" || bad "git"
    has jq   && ok "jq"  || bad "jq" "brew install jq"
    [ -d /Applications/Obsidian.app ]  && ok "Obsidian 앱"  || bad "Obsidian 앱" "brew install --cask obsidian"
    [ -d /Applications/Tailscale.app ] && ok "Tailscale 앱" || bad "Tailscale 앱" "brew install --cask tailscale-app"
    [ -d /Applications/Aside.app ]     && ok "Aside 앱"     || bad "Aside 앱" "설치 방법 확인 필요(서드파티)"
    has aside && ok "aside CLI" "$(aside --version 2>/dev/null)" || bad "aside CLI" "Aside 앱에서 CLI 활성화"
}

check_remote() {
    sec 3 "원격 통로"
    if [ -x "$TS_BIN" ]; then
        local ip; ip=$("$TS_BIN" ip -4 2>/dev/null | head -1)
        [ -n "$ip" ] && ok "Tailscale 연결" "$ip" || bad "Tailscale 연결" "tailscale up --authkey=<페어링 코드에서>"
    else bad "Tailscale CLI" "앱 미설치"; fi
}

check_box() {
    sec 4 "박스 골격 ($ILSON_HOME)"
    if [ -d "$ILSON_HOME" ]; then
        ok "박스 폴더" "$(is_sandbox_box && echo '샌드박스')"
        [ -f "$ILSON_HOME/CLAUDE.md" ]          && ok "행동 규칙 CLAUDE.md" || bad "행동 규칙 CLAUDE.md"
        [ -f "$ILSON_HOME/vault/CONTEXT.md" ]   && ok "볼트 틀"            || bad "볼트 틀"
        [ -d "$ILSON_HOME/.claude/commands" ]   && ok "명령 4개(.claude)"  "$(ls "$ILSON_HOME/.claude/commands" 2>/dev/null | wc -l | tr -d ' ')개" || bad "명령(.claude/commands)"
        [ -x "$ILSON_HOME/lib/run-job.sh" ]     && ok "lib 스크립트"       || bad "lib 스크립트"
        [ -d "$ILSON_HOME/.git" ]               && ok "상태 git 스냅샷"    || bad "상태 git 스냅샷" "lib/snapshot.sh 1회 실행"
        # Project-scope allow rules are ignored until the trust dialog is accepted for
        # this folder (measured 2026-09-05). Jobs use acceptEdits so they still write,
        # but deny rules and any allow rules need trust to be fully honored.
        if jq -e --arg p "$ILSON_HOME" '.projects[$p].hasTrustDialogAccepted == true' "$HOME/.claude.json" >/dev/null 2>&1; then
            ok "박스 신뢰됨(Claude)"
        else warn "박스 미신뢰(Claude)" "박스 폴더에서 claude 를 한 번 열어 신뢰 수락 (init 10단계가 함)"; fi
    else
        bad "박스 폴더" "ilson init 이 만든다"
    fi
    sec 5 "페어링"
    if [ -f "$ILSON_HOME/state/pairing.json" ]; then
        local c; c=$(jq -r '.code // empty' "$ILSON_HOME/state/pairing.json" 2>/dev/null)
        ok "페어링 파일" "코드 $c"
        [ -n "$(jq -r '.telegram_chat_id // empty' "$ILSON_HOME/state/pairing.json" 2>/dev/null)" ] && ok "텔레그램 연결" || warn "텔레그램 미연결" "알림은 로그로만 남음"
    else bad "페어링" "ilson pair --code XXXX-XXXX"; fi
}

check_tcc() {
    sec 6 "권한 (접근성·자동화·전체 디스크)"
    if [ "$PROBE_TCC" = "1" ]; then
        osascript -e 'tell application "System Events" to get name of first process' >/dev/null 2>&1 \
            && ok "자동화+접근성" "System Events 호출 성공" || bad "자동화+접근성" "시스템 설정 > 개인정보 보호에서 터미널 허용"
    else warn "권한 실호출" "--probe-tcc 로 검사 (권한 창이 뜰 수 있음)"; fi
    [ -r "$HOME/Library/Application Support/com.apple.TCC/TCC.db" ] && ok "전체 디스크 접근" || warn "전체 디스크 접근" "이 터미널엔 없음"
}

check_jobs() {
    sec 8 "예약 업무 (launchd)"
    local dir n loaded
    if is_sandbox_box; then dir="$ILSON_HOME/launchd/rendered"; else dir="$LAUNCH_AGENTS"; fi
    n=$(ls "$dir" 2>/dev/null | grep -c '^com\.ilson\..*\.plist$')
    if [ "$n" -gt 0 ]; then
        ok "ilson 잡 plist" "${n}개$(is_sandbox_box && echo ' (렌더만)')"
        for p in "$dir"/com.ilson.*.plist; do plutil -lint -s "$p" >/dev/null 2>&1 || bad "plist 문법" "$(basename "$p")"; done
        if is_sandbox_box; then skip "잡 적재(launchctl)"; else
            loaded=$(launchctl list 2>/dev/null | grep -c 'com\.ilson\.')
            [ "$loaded" -eq "$n" ] && ok "잡 적재" "${loaded}/${n}" || bad "잡 적재" "${loaded}/${n} (launchctl bootstrap 필요)"
        fi
    else bad "ilson 잡 plist" "6개 (브리핑·주간·정리·워치독·스냅샷·업데이트)"; fi
}

check_safety() {
    sec 9 "안전판"
    [ -f "$ILSON_HOME/state/spend-cap.ack" ] && ok "API 지출 상한 확인" || warn "API 지출 상한" "Anthropic 콘솔에서 사람이 설정"
    [ -f "$ILSON_HOME/state/enabled.watchdog" ] && ok "워치독" || bad "워치독"
    [ -f "$ILSON_HOME/state/enabled.snapshot" ] && ok "상태 스냅샷(10분)" || bad "상태 스냅샷(10분)"
}

doctor() {
    printf 'ilson doctor v0 — %s · %s\n' "$(hostname -s)" "$(date '+%Y-%m-%d %H:%M')"
    check_preflight; check_machine; check_tools; check_remote; check_box; check_tcc; check_jobs; check_safety
    printf '\n결과: ✅ %d · ⚠️ %d · ❌ %d\n' "$PASS" "$WARN" "$FAIL"
    [ "$FAIL" -eq 0 ] && { echo "박스가 준비됐어요."; exit 0; }
    echo "❌ 항목은 'ilson init' 이 처리하거나, 새 맥에서 손으로 할 것들이에요."
    exit 1
}

# ============================================================================
# init — build the box
# ============================================================================

# render_plist <job> <script> <args> <schedule> > file
render_plist() {
    local job="$1" script="$2" args="$3" sched="$4" argxml="" schedxml=""
    [ -n "$args" ] && argxml="<string>$args</string>"
    case "$sched" in
        daily\ *)  set -- $sched; schedxml="<key>StartCalendarInterval</key><dict><key>Hour</key><integer>${2%%:*}</integer><key>Minute</key><integer>$((10#${2##*:}))</integer></dict>" ;;
        weekly\ *) set -- $sched; schedxml="<key>StartCalendarInterval</key><dict><key>Weekday</key><integer>$2</integer><key>Hour</key><integer>${3%%:*}</integer><key>Minute</key><integer>$((10#${3##*:}))</integer></dict>" ;;
        every\ *)  set -- $sched; schedxml="<key>StartInterval</key><integer>$2</integer>" ;;
        *) die "jobs.conf: 모르는 일정 '$sched'" ;;
    esac
    sed -e "s#__JOB__#$job#g" -e "s#__SCRIPT__#$script#g" -e "s#__ARGS__#$argxml#g" \
        -e "s#__SCHEDULE__#$schedxml#g" -e "s#__ILSON_HOME__#$ILSON_HOME#g" -e "s#__HOME__#$HOME#g" \
        "$TEMPLATE/launchd/job.plist.tmpl"
}

init_step_machine() {
    sec 1 "기계 세팅"
    if [ "$SANDBOX" = "1" ]; then skip "pmset·자동 로그인·SSH"; return; fi
    # Real mode — needs an admin password once. Each command is idempotent.
    sudo -p "관리자 비밀번호 (기계 세팅): " pmset -a sleep 0 disksleep 0 displaysleep 10 autorestart 1 womp 1 && ok "잠자기 금지·자동 재시작" || bad "pmset"
    if [ -z "$(defaults read /Library/Preferences/com.apple.loginwindow autoLoginUser 2>/dev/null)" ]; then
        sudo sysadminctl -autologin set -userName "$USER" && ok "자동 로그인" "$USER" || bad "자동 로그인"
    else ok "자동 로그인" "이미 설정"; fi
    sudo systemsetup -setremotelogin on >/dev/null 2>&1 && ok "SSH" || warn "SSH" "systemsetup 실패"
}

init_step_tools() {
    sec 2 "도구"
    if [ "$SANDBOX" = "1" ]; then skip "brew install"; return; fi
    has brew || die "Homebrew 가 없어요. https://brew.sh 한 줄 설치 후 다시."
    for f in git jq; do has "$f" || brew install -q "$f"; done
    [ -d /Applications/Obsidian.app ]  || brew install -q --cask obsidian
    [ -d /Applications/Tailscale.app ] || brew install -q --cask tailscale-app
    ok "도구 설치"
}

init_step_remote() {
    sec 3 "원격 통로"
    if [ "$SANDBOX" = "1" ]; then skip "tailscale up"; return; fi
    local key; key=$(jq -r '.tailscale_authkey // empty' "$ILSON_HOME/state/pairing.json" 2>/dev/null)
    if [ -n "$key" ] && [ -x "$TS_BIN" ]; then "$TS_BIN" up --authkey="$key" >/dev/null 2>&1 && ok "Tailscale" || bad "Tailscale up"; else warn "Tailscale" "페어링에 authkey 없음 — 앱에서 로그인"; fi
}

init_step_box() {
    sec 4 "박스 골격 → $ILSON_HOME"
    mkdir -p "$ILSON_HOME"
    # vault/ is the customer's data: -n never overwrites an existing note on re-run.
    # lib/, .claude/, CLAUDE.md are our layer: always refreshed.
    mkdir -p "$ILSON_HOME/vault" && cp -Rn "$TEMPLATE/vault/." "$ILSON_HOME/vault/"
    cp -R "$TEMPLATE/lib/." "$ILSON_HOME/lib/"; chmod +x "$ILSON_HOME"/lib/*.sh
    mkdir -p "$ILSON_HOME/.claude" && cp -R "$TEMPLATE/claude/." "$ILSON_HOME/.claude/"
    cp "$TEMPLATE/CLAUDE.md" "$ILSON_HOME/CLAUDE.md"
    mkdir -p "$ILSON_HOME/launchd" && cp "$TEMPLATE/launchd/jobs.conf" "$ILSON_HOME/launchd/"
    sed -i '' "s/__TODAY__/$(date +%F)/" "$ILSON_HOME/vault/CONTEXT.md"
    mkdir -p "$ILSON_HOME/state" "$ILSON_HOME/logs"
    [ "$SANDBOX" = "1" ] && touch "$ILSON_HOME/state/sandbox"
    ILSON_HOME="$ILSON_HOME" bash "$ILSON_HOME/lib/snapshot.sh" && ok "골격 복사 + 첫 스냅샷" || bad "스냅샷"
}

init_step_pair() {
    sec 5 "페어링"
    pair_write && ok "pairing.json" "코드 $CODE" || bad "페어링"
    if [ "$SANDBOX" = "1" ]; then skip "텔레그램 「시작」 대기"; return; fi
    local link; link=$(jq -r '.telegram_pair_link // empty' "$ILSON_HOME/state/pairing.json")
    if [ -n "$link" ]; then open "$link"; warn "텔레그램" "사장님 폰에서 「시작」을 누르면 이어집니다 (v0: 대기 미구현)"; else warn "텔레그램" "페어링에 링크 없음"; fi
}

# pair_write — v0 has no server: code + optional --pairing-file JSON merged in.
pair_write() {
    mkdir -p "$ILSON_HOME/state"
    local base; base=$(jq -n --arg c "$CODE" --arg t "$(date -Iseconds)" '{code:$c, paired_at:$t, source:"v0-file"}')
    if [ -n "$PAIRING_FILE" ]; then
        [ -f "$PAIRING_FILE" ] || die "페어링 파일이 없어요: $PAIRING_FILE"
        jq -s '.[0] * .[1]' <(echo "$base") "$PAIRING_FILE" > "$ILSON_HOME/state/pairing.json"
    else echo "$base" > "$ILSON_HOME/state/pairing.json"; fi
    chmod 600 "$ILSON_HOME/state/pairing.json"
}

init_step_tcc() {
    sec 6 "권한 클릭"
    if [ "$SANDBOX" = "1" ]; then skip "설정창 열기"; return; fi
    for pane in Privacy_Accessibility Privacy_Automation Privacy_AllFiles; do
        open "x-apple.systempreferences:com.apple.preference.security?$pane"
        printf '  ▶ 열린 창에서 「터미널」을 켜고 Enter: '; read -r _
    done
    osascript -e 'tell application "System Events" to get name of first process' >/dev/null 2>&1 && ok "권한 확인" || warn "권한" "아직 안 잡힘 — 나중에 ilson doctor --probe-tcc"
}

init_step_jobs() {
    sec 8 "예약 업무"
    local out="$ILSON_HOME/launchd/rendered"; mkdir -p "$out"
    while IFS='|' read -r job script args sched; do
        job=$(echo "$job" | xargs); [ -z "$job" ] && continue; case "$job" in \#*) continue ;; esac
        script=$(echo "$script" | xargs); args=$(echo "$args" | xargs); sched=$(echo "$sched" | xargs)
        render_plist "$job" "$script" "$args" "$sched" > "$out/com.ilson.$job.plist"
        plutil -lint -s "$out/com.ilson.$job.plist" >/dev/null || die "plist 렌더 실패: $job"
        touch "$ILSON_HOME/state/enabled.$job"
    done < "$ILSON_HOME/launchd/jobs.conf"
    ok "plist 렌더" "$(ls "$out" | wc -l | tr -d ' ')개"
    if [ "$SANDBOX" = "1" ]; then skip "launchctl bootstrap"; return; fi
    mkdir -p "$LAUNCH_AGENTS"
    for p in "$out"/com.ilson.*.plist; do
        cp "$p" "$LAUNCH_AGENTS/"; launchctl bootout "gui/$(id -u)" "$LAUNCH_AGENTS/$(basename "$p")" 2>/dev/null
        launchctl bootstrap "gui/$(id -u)" "$LAUNCH_AGENTS/$(basename "$p")" || bad "적재" "$(basename "$p")"
    done
    ok "launchd 적재"
}

init_step_safety() {
    sec 9 "안전판"
    if [ "$SANDBOX" = "1" ]; then echo "sandbox" > "$ILSON_HOME/state/spend-cap.ack"; skip "콘솔 링크"; return; fi
    open "https://console.anthropic.com/settings/limits"
    printf '  ▶ 월 지출 상한을 정하고 Enter: '; read -r _; date > "$ILSON_HOME/state/spend-cap.ack"; ok "지출 상한 확인"
}

init_step_onboard() {
    sec 10 "첫 출근 인터뷰"
    if [ "$SANDBOX" = "1" ] && [ "$WITH_CLAUDE" = "0" ]; then skip "claude /onboard (--with-claude 로 실행)"; return; fi
    printf '  ▶ Claude 가 열립니다. 사장님과 대화가 끝나면 /exit 로 나오세요. Enter: '; read -r _
    (cd "$ILSON_HOME" && claude "/onboard")
    ok "인터뷰 세션 종료"
}

init_step_accept() {
    sec 11 "인수 시험"
    if [ "$SANDBOX" = "1" ] && [ "$WITH_CLAUDE" = "0" ]; then skip "브리핑 1회 실발송 (--with-claude)"; return; fi
    ILSON_HOME="$ILSON_HOME" bash "$ILSON_HOME/lib/run-job.sh" briefing && ok "브리핑 발송" "텔레그램 확인" || bad "브리핑"
}

init() {
    [ -n "$CODE" ] || die "사용법: ilson init --code XXXX-XXXX [--sandbox]"
    printf 'ilson init v0 — %s · 코드 %s%s\n' "$ILSON_HOME" "$CODE" "$( [ "$SANDBOX" = "1" ] && echo ' · 샌드박스')"
    check_preflight
    init_step_machine; init_step_tools; init_step_box; init_step_pair; init_step_remote
    init_step_tcc; init_step_jobs; init_step_safety; init_step_onboard; init_step_accept
    printf '\n완료: ✅ %d · ⚠️ %d · ❌ %d — 확인: ILSON_HOME=%s ilson doctor\n' "$PASS" "$WARN" "$FAIL" "$ILSON_HOME"
    [ "$FAIL" -eq 0 ]
}

usage() {
    cat <<'EOF'
사용법: ilson <명령> [옵션]
  doctor [--probe-tcc]                          박스 상태를 읽기 전용으로 점검
  init --code <코드> [--sandbox] [--with-claude] 한 줄 온보딩 (샌드박스: $ILSON_HOME 밖은 안 건드림)
  pair --code <코드> [--pairing-file <json>]     페어링 파일 (다시) 쓰기
  update                                        우리 레이어 업데이트
EOF
}

cmd="${1:-}"; shift || true
while [ $# -gt 0 ]; do
    case "$1" in
        --probe-tcc) PROBE_TCC=1 ;;
        --sandbox) SANDBOX=1 ;;
        --with-claude) WITH_CLAUDE=1 ;;
        --code) CODE="${2:-}"; shift ;;
        --pairing-file) PAIRING_FILE="${2:-}"; shift ;;
        *) echo "모르는 옵션: $1" >&2; usage; exit 2 ;;
    esac; shift
done
case "$cmd" in
    doctor) doctor ;;
    init)   init ;;
    pair)   [ -n "$CODE" ] || die "ilson pair --code XXXX"; pair_write && echo "pairing.json 갱신"; ;;
    update) [ -x "$ILSON_HOME/lib/update.sh" ] || die "박스가 없어요 ($ILSON_HOME)"; ILSON_HOME="$ILSON_HOME" bash "$ILSON_HOME/lib/update.sh" ;;
    *) usage; exit 2 ;;
esac
