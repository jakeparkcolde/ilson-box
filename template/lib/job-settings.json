{
  "model": "sonnet",
  "disableAllHooks": true,
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Read", "Glob", "Grep",
      "Edit(./vault/**)", "Write(./vault/**)",
      "WebSearch", "WebFetch",
      "Bash(date)", "Bash(bash lib/search.sh *)"
    ],
    "deny": [
      "Read(**/pairing.json)", "Read(**/.env*)",
      "Read(./vault/.ilson-learning/**)",
      "Edit(./vault/.ilson-learning/**)", "Write(./vault/.ilson-learning/**)",
      "Edit(./vault/lessons/approved-learning.md)", "Write(./vault/lessons/approved-learning.md)",
      "Edit(./lib/**)", "Write(./lib/**)",
      "Edit(./.claude/**)", "Write(./.claude/**)",
      "Edit(./launchd/**)", "Write(./launchd/**)",
      "Edit(./state/**)", "Write(./state/**)",
      "Edit(./CLAUDE.md)", "Write(./CLAUDE.md)"
    ]
  }
}
