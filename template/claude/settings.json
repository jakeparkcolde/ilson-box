{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "sonnet",
  "env": {
    "DISABLE_AUTOUPDATER": "1",
    "DISABLE_TELEMETRY": "1"
  },
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit(vault/**)",
      "Write(vault/**)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(date:*)",
      "Bash(bash lib/search.sh *)"
    ],
    "deny": [
      "Bash(curl:*)",
      "Bash(rm:*)",
      "Bash(sudo:*)",
      "Read(**/pairing.json)",
      "Read(**/.env)"
    ]
  }
}
