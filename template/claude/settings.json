{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "sonnet",
  "env": {
    "DISABLE_AUTOUPDATER": "1",
    "DISABLE_TELEMETRY": "1"
  },
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "WebSearch",
      "WebFetch",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(date:*)",
      "Bash(bash lib/search.sh *)"
    ],
    "ask": [
      "Bash(sudo *)",
      "Bash(rm *)",
      "Bash(rmdir *)"
    ],
    "deny": [
      "Read(**/pairing.json)",
      "Read(**/.env)"
    ]
  }
}
